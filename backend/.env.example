# Copy to backend/.env and fill in. Never commit the real .env.

# OpenAI API key used by bia/providers/openai/.
OPENAI_API_KEY=

# Supabase connection string. Use the transaction pooler (port 6543) in serverless deploys.
DATABASE_URL=

# Shared password for the API and Swagger (HTTP Basic, any username). At least 16 characters.
API_ACCESS_PASSWORD=

# One of: development, test, production.
ENVIRONMENT=development

# Optional, defaults to INFO. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Optional, only for tests: pass it as a process variable to run the integration tests
# against a real database. They create tables and seed rows. Not read from this file.
# INTEGRATION_DATABASE_URL=
